<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The native deps live here, NOT in core. This is the only project in the
       submodule allowed to reference SkiaSharp / Svg.Skia / QuestPDF /
       DocumentFormat.OpenXml. -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.2.3" />
    <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    <PackageReference Include="Svg.Skia" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackgammonDiagram_Lib\BackgammonDiagram_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackgammonDiagram_Lib.Tests" />
  </ItemGroup>

</Project>
